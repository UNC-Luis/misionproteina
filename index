function startMission(id) {
  const m = byId(id);
  G.run = { m, steps: m.steps(), i: 0, ctx: { locks: [false, false, false, false], opened: -1 } };
  G.screen = 'play'; startStep();
}
function startStep() {
  const r = G.run, st = r.steps[r.i];
  r.ctx.opened = -1;
  if (st.init) st.init(r.ctx);
  r.s = VIEWS[st.type].init(st, r.ctx, r.m.id + ':' + r.i);
  render(); window.scrollTo(0, 0);
}
function next() {
  const r = G.run; if (!r) return;
  r.i++;
  if (r.i >= r.steps.length) { G.saved.done[r.m.id] = true; save(); G.mid = r.m.id; G.run = null; go('done'); sfx('win'); confetti(); return; }
  startStep();
}
