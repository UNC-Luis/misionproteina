<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Misión Proteína</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="description" content="Juego para aprender replicación, transcripción, traducción y mutaciones resolviendo problemas.">
<style>
@font-face{font-family:'Atkinson Hyperlegible';font-style:normal;font-weight:400;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
@font-face{font-family:'Atkinson Hyperlegible';font-style:normal;font-weight:700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
@font-face{font-family:'Bricolage Grotesque';font-style:normal;font-weight:700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
@font-face{font-family:'Bricolage Grotesque';font-style:normal;font-weight:800;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:700;font-display:swap;src:url(data:font/woff2;base64,) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+2000-206F,U+2074,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;}
:root{
  color-scheme: dark;
  --bg:#0a1228; --bg2:#0e1834; --card:#132046; --card2:#1a2a58; --line:#2a3e78; --ink:#eef3ff; --mute:#a7b6dc; --dim:#7081b0;
  --amber:#ffb547; --good:#2ee6a6; --bad:#ff7a7a; --ribo:#8fa2ff;
  --A:#ff6b6b; --T:#ffd166; --G:#2ee6a6; --C:#4dabf7; --U:#b197fc;
  --A2:rgba(255,107,107,.15); --T2:rgba(255,209,102,.14); --G2:rgba(46,230,166,.14); --C2:rgba(77,171,247,.15); --U2:rgba(177,151,252,.16);
  --tile: clamp(28px, 8.6vw, 44px);
  --ts: clamp(18px, 4.9vw, 26px);
  --f-d: 'Bricolage Grotesque', system-ui, sans-serif;
  --f-b: 'Atkinson Hyperlegible', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --f-m: 'JetBrains Mono', ui-monospace, Menlo, Consolas, monospace;
  --gl: max(16px, env(safe-area-inset-left, 0px));
  --gr: max(16px, env(safe-area-inset-right, 0px));
}
*{ box-sizing:border-box }
html{ -webkit-text-size-adjust:100%; text-size-adjust:100% }
body{ margin:0; background:var(--bg); color:var(--ink); font:16px/1.45 var(--f-b); min-height:100vh; min-height:100dvh; overflow-x:hidden }
body::before{ content:''; position:fixed; inset:0; z-index:-1; pointer-events:none;
  background: radial-gradient(110% 55% at 50% -12%, #1c3170 0%, rgba(28,49,112,0) 62%), radial-gradient(60% 40% at 100% 105%, rgba(255,181,71,.07), rgba(255,181,71,0) 70%); }
button{ font:inherit; color:inherit; cursor:pointer; -webkit-tap-highlight-color:transparent }
button:disabled{ cursor:default }
:focus-visible{ outline:3px solid var(--amber); outline-offset:2px }
[hidden]{ display:none !important }
h1,h2,h3,h4,p{ margin:0 }
b,strong{ font-weight:700 }
.mono{ font-family:var(--f-m) }
.ic{ width:22px; height:22px; flex:none }

/* ---------- top bar ---------- */
.bar{ position:sticky; top:0; z-index:30; display:flex; align-items:center; gap:8px; height:58px;
  padding:0 var(--gr) 0 var(--gl); background:rgba(10,18,40,.88); -webkit-backdrop-filter:blur(10px); backdrop-filter:blur(10px);
  border-bottom:1px solid rgba(42,62,120,.65) }
.brand{ flex:1; min-width:0; display:flex; align-items:center; gap:8px; background:none; border:0; padding:0; text-align:left;
  font:800 19px/1 var(--f-d); letter-spacing:-.01em; white-space:nowrap; overflow:hidden }
.brand span{ overflow:hidden; text-overflow:ellipsis }
.brand .ribo{ width:34px; flex:none }
.bar-r{ display:flex; gap:6px; flex:none }
.ib{ height:40px; min-width:40px; padding:0 9px; border-radius:12px; border:1px solid var(--line); background:var(--card);
  display:inline-flex; align-items:center; justify-content:center; gap:6px }
.ib:hover{ background:var(--card2) }
.ib.pill{ font:700 14px/1 var(--f-b); letter-spacing:.04em }

/* ---------- layout ---------- */
#app{ padding:0 var(--gr) 0 var(--gl) }
.col{ max-width:660px; margin:0 auto }
.screen{ min-height:calc(100vh - 58px); min-height:calc(100dvh - 58px); display:flex; flex-direction:column; padding-top:18px }
.btn{ display:inline-flex; align-items:center; justify-content:center; gap:8px; min-height:50px; padding:12px 20px; border-radius:16px;
  border:1px solid var(--line); background:var(--card); font-weight:700; font-size:16px; text-decoration:none }
.btn:hover{ background:var(--card2) }
.btn.primary{ background:var(--amber); border-color:var(--amber); color:#1a1200; box-shadow:inset 0 -4px 0 rgba(0,0,0,.18) }
.btn.primary:hover{ background:#ffc266 }
.btn.big{ width:100%; min-height:58px; font-size:18px; font-family:var(--f-d) }
.btn.ghost{ background:transparent }
.mute{ color:var(--mute) }
.small{ font-size:14px }

/* ---------- Ribo + speech ---------- */
.ribo{ display:block; width:44px; height:auto }
.say{ display:flex; gap:12px; align-items:flex-start; margin:18px 0 6px }
.say .ribo{ width:56px; flex:none; margin-top:4px }
.say p{ position:relative; background:var(--card); border:1px solid var(--line); border-radius:4px 18px 18px 18px; padding:12px 14px; font-size:15.5px }

/* ---------- home ---------- */
.hero{ text-align:left; padding-top:6px }
.kick{ font:700 12.5px/1 var(--f-b); letter-spacing:.14em; text-transform:uppercase; color:var(--amber) }
.h1{ font:800 clamp(38px, 11vw, 60px)/.95 var(--f-d); letter-spacing:-.03em; margin:10px 0 10px }
.h1 em{ font-style:normal; color:var(--amber) }
.lead{ font-size:17px; color:var(--mute); max-width:34em }
.pchain{ display:flex; align-items:center; margin:18px 0 4px }
.pchain i{ flex:1; height:4px; border-radius:2px; background:var(--line); min-width:10px }
.pchain i.on{ background:linear-gradient(90deg, var(--amber), #ffd98f) }
.pb{ width:38px; height:38px; border-radius:50%; display:grid; place-items:center; font:800 15px var(--f-d); border:2px dashed var(--dim); color:var(--mute); flex:none }
.pb.on{ border:0; background:var(--mc); color:#0a1228 }
.pb .ic{ width:20px; height:20px; stroke-width:3 }
.pcap{ font-size:14px; color:var(--mute) }
.mlist{ list-style:none; padding:0; margin:20px 0 8px; display:grid; gap:12px }
.mcard{ width:100%; display:grid; grid-template-columns:56px 1fr auto; gap:14px; align-items:center; text-align:left;
  background:var(--card); border:1px solid var(--line); border-radius:20px; padding:12px 14px 12px 12px; transition:transform .12s, background .12s }
.mcard:hover{ background:var(--card2) }
.mcard:active{ transform:scale(.985) }
.hex{ width:56px; height:62px; display:grid; place-items:center; background:var(--mc); color:#0a1228;
  clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%) }
.hex .ic{ width:28px; height:28px; stroke-width:2.2 }
.mtop{ font:700 12px/1 var(--f-b); letter-spacing:.1em; text-transform:uppercase; color:var(--mute) }
.mt{ font:800 19px/1.15 var(--f-d); margin:5px 0 3px }
.mmeta{ font-size:14px; color:var(--mute) }
.mstat{ font:700 13px var(--f-b); padding:7px 10px; border-radius:999px; background:var(--bg2); border:1px solid var(--line); white-space:nowrap; display:inline-flex; align-items:center; gap:4px }
.mstat.on{ background:rgba(46,230,166,.14); border-color:rgba(46,230,166,.5); color:var(--good) }
.mstat .ic{ width:16px; height:16px; stroke-width:3 }
.links{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin:10px 0 22px }
.links .btn{ font-size:15px; min-height:54px; padding:10px 12px }
.links .wide{ grid-column:1 / -1 }
.foot{ font-size:13px; color:var(--dim); text-align:center; padding:6px 0 26px }

/* ---------- briefing ---------- */
.bhead{ display:grid; grid-template-columns:72px 1fr; gap:16px; align-items:center }
.bhead .hex{ width:72px; height:80px }
.bhead .hex .ic{ width:36px; height:36px }
.bt{ font:800 clamp(28px, 8vw, 40px)/1 var(--f-d); letter-spacing:-.02em; margin-top:6px }
.btopic{ color:var(--mute); margin-top:4px }
.story{ font-size:17.5px; margin:20px 0 16px; line-height:1.5 }
.rules{ background:var(--bg2); border:1px solid var(--line); border-radius:18px; padding:14px 16px; margin-bottom:12px }
.rules h3{ font:700 13px var(--f-b); letter-spacing:.1em; text-transform:uppercase; color:var(--amber); margin-bottom:8px }
.rules ul{ margin:0; padding-left:20px; display:grid; gap:6px }
.rules li::marker{ color:var(--amber) }
.spacer{ flex:1; min-height:14px }
.stick{ position:sticky; bottom:0; padding:12px 0 calc(14px + env(safe-area-inset-bottom, 0px));
  background:linear-gradient(to bottom, rgba(10,18,40,0), var(--bg) 16px) }

/* ---------- play header ---------- */
.ph{ display:flex; align-items:center; gap:10px }
.mchip{ width:38px; height:42px; flex:none; display:grid; place-items:center; background:var(--mc); color:#0a1228; font:800 15px var(--f-d);
  clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%) }
.ph-t{ font:800 16px/1.1 var(--f-d) }
.ph-k{ font:700 13px/1.2 var(--f-b); color:var(--amber); margin-top:3px }
.prog{ display:flex; gap:4px; margin:12px 0 4px }
.prog i{ flex:1; height:6px; border-radius:3px; background:var(--line) }
.prog i.on{ background:var(--mc) }
.prog i.now{ background:linear-gradient(90deg, var(--mc), var(--line)) }
.stage{ flex:1; padding:10px 0 4px }
.q{ font:700 clamp(18px, 4.8vw, 21px)/1.3 var(--f-b); margin:6px 0 10px }
.ctitle{ font:800 19px/1.2 var(--f-d); margin:4px 0 10px; color:var(--ink) }
.sub{ font-weight:700; margin:14px 0 4px }
.note, .explain{ margin-top:16px; border-radius:16px; padding:14px 16px; scroll-margin-bottom:180px; line-height:1.5 }
.note{ background:rgba(255,181,71,.1); border:1px solid rgba(255,181,71,.4) }
.explain{ background:rgba(46,230,166,.09); border:1px solid rgba(46,230,166,.38) }
.explain p + p{ margin-top:8px }
.seqtxt{ font-family:var(--f-m); font-weight:700; letter-spacing:.04em; white-space:nowrap }
.seqtxt .bA{ color:var(--A) } .seqtxt .bT{ color:var(--T) } .seqtxt .bG{ color:var(--G) } .seqtxt .bC{ color:var(--C) } .seqtxt .bU{ color:var(--U) }

/* ---------- tiles ---------- */
.b-A{ --bc:var(--A); --bc2:var(--A2) } .b-T{ --bc:var(--T); --bc2:var(--T2) } .b-G{ --bc:var(--G); --bc2:var(--G2) }
.b-C{ --bc:var(--C); --bc2:var(--C2) } .b-U{ --bc:var(--U); --bc2:var(--U2) } .b-q{ --bc:#33467f; --bc2:rgba(51,70,127,.3) }
.t{ width:var(--tile); height:calc(var(--tile) * 1.16); border-radius:8px; display:grid; place-items:center; flex:none; padding:0; border:0;
  font:700 calc(var(--tile) * .56)/1 var(--f-m); color:#0a1228; background:var(--bc); box-shadow:inset 0 -3px 0 rgba(0,0,0,.18) }
.t.tpl{ background:var(--bc2); color:var(--bc); box-shadow:inset 0 0 0 1.5px var(--bc) }
.t.sm{ width:var(--ts); height:calc(var(--ts) * 1.16); border-radius:6px; font-size:calc(var(--ts) * .6); box-shadow:inset 0 -2px 0 rgba(0,0,0,.18) }
.t.xs{ width:20px; height:23px; border-radius:5px; font-size:12.5px; box-shadow:none }
.t.qm{ background:transparent; color:var(--mute); box-shadow:inset 0 0 0 1.5px var(--dim) }
.slot{ background:transparent; box-shadow:none; border:2px dashed var(--line) }
.slot.cur{ border:2.5px solid var(--amber); box-shadow:0 0 0 4px rgba(255,181,71,.18); animation:curp 1.3s ease-in-out infinite }
.t.pop{ animation:pop .34s cubic-bezier(.3,1.6,.5,1) }
.t.chg{ outline:2.5px solid #fff; outline-offset:1.5px }
button.t{ cursor:pointer }
.tapt{ outline:1.5px dashed rgba(238,243,255,.35); outline-offset:2px }
.tapt:hover{ outline-color:var(--amber) }
.t.hlx, .t.hlt{ outline:3px solid var(--amber); outline-offset:2px }
.t.badt{ opacity:.35 }
.ladder{ display:flex; flex-wrap:wrap; justify-content:center; align-items:flex-start; gap:16px 8px; margin:18px 0 6px }
.cg{ display:flex; gap:3px }
.bp{ display:flex; flex-direction:column; align-items:center }
.rung{ width:3px; height:12px; border-radius:2px; background:var(--line) }
.rung.on{ background:rgba(238,243,255,.55) }
.caps{ display:flex; flex-direction:column; justify-content:space-between; height:calc(var(--tile) * 2.32 + 12px); padding:calc(var(--tile) * .3) 0;
  font:700 12px/1 var(--f-m); color:var(--mute) }
.lg{ display:flex; flex-wrap:wrap; justify-content:center; gap:6px 16px; font-size:13.5px; color:var(--mute) }
.lg span{ display:inline-flex; align-items:center; gap:6px }
.lg i{ width:14px; height:14px; border-radius:4px; display:inline-block }
.lg .ltpl{ background:rgba(167,182,220,.15); box-shadow:inset 0 0 0 1.5px var(--mute) }
.lg .lnew{ background:linear-gradient(135deg, var(--A), var(--T) 35%, var(--G) 65%, var(--C)) }
.lg .lrna{ background:linear-gradient(135deg, var(--A), var(--U) 35%, var(--G) 65%, var(--C)) }

/* ---------- sequences, panels ---------- */
.seqrow{ display:flex; flex-wrap:wrap; align-items:center; gap:4px }
.seqrow .cg{ padding:2px; gap:2px; border-radius:8px; border:0; outline:1.5px solid transparent; outline-offset:1px; background:none; color:inherit }
.cap1{ font:700 12px/1 var(--f-m); color:var(--mute); padding:0 }
.cgw{ display:inline-flex; align-items:center; gap:4px }
.ladder .cgw{ align-items:flex-start; gap:6px }
.seqrow.letters{ gap:3px }
.seqrow.letters .cgw{ gap:3px }
.seqrow .tapc{ outline:1.5px dashed rgba(238,243,255,.38); cursor:pointer }
.seqrow .tapc:hover{ outline-color:var(--amber) }
.seqrow .cg.hl{ outline:2px solid var(--amber); background:rgba(255,181,71,.13) }
.cg.badg{ opacity:.4 }
.seqrow .cg.hintg{ outline:2px solid var(--amber); animation:curp 1.2s infinite }
.cg.dim{ opacity:.32 }
.cg.past{ opacity:.45 }
.seqrow .cg.ribo-on{ background:rgba(143,162,255,.18); outline:2px solid var(--ribo); box-shadow:0 0 0 5px rgba(143,162,255,.16) }
.track{ margin:12px 0 2px }
.panel{ background:var(--bg2); border:1px solid var(--line); border-radius:18px; padding:12px 10px; display:grid; gap:14px; margin:4px 0 6px }
.prow{ display:grid; gap:7px }
.prow + .prow{ border-top:1px dashed var(--line); padding-top:12px }
.prow h4{ font:700 14px/1.1 var(--f-b); color:var(--ink) }
.prow.mut h4{ color:var(--amber) }
.lbl{ font:700 12.5px/1.1 var(--f-b); color:var(--mute); margin-top:2px }

/* ---------- amino acid beads ---------- */
.chain{ display:flex; flex-wrap:wrap; align-items:center; row-gap:8px; min-height:44px }
.bead{ position:relative; width:44px; height:44px; flex:none; border-radius:50%; display:grid; place-items:center; margin-right:10px;
  font:800 12.5px/1 var(--f-b); color:#0a1228; background:var(--ac, #f6c177); box-shadow:inset 0 -3px 0 rgba(0,0,0,.15) }
.chain .bead + .bead::before{ content:''; position:absolute; right:100%; top:50%; width:10px; height:3px; margin-top:-1.5px; background:var(--mute) }
.bead.np{ --ac:#f6c177 } .bead.po{ --ac:#9ccfd8 } .bead.ac{ --ac:#eb6f92 } .bead.ba{ --ac:#c4a7e7 }
.bead.stop{ --ac:#ff7a7a; border-radius:0; font-size:10.5px; clip-path:polygon(30% 0,70% 0,100% 30%,100% 70%,70% 100%,30% 100%,0 70%,0 30%) }
.bead.q{ background:transparent; box-shadow:inset 0 0 0 2px var(--dim); color:var(--mute); font-size:16px }
.bead.new{ animation:pop .45s cubic-bezier(.3,1.6,.5,1) }
.bead.sm{ width:34px; height:34px; font-size:11px; margin-right:0 }
.binl{ display:inline-flex; flex-wrap:wrap; align-items:center; gap:4px }
.binl .bead{ width:36px; height:36px; font-size:11px; margin-right:6px }
.binl .bead + .bead::before{ content:''; position:absolute; right:100%; top:50%; width:6px; height:2px; background:var(--mute) }

/* ---------- options ---------- */
.opts{ display:grid; gap:10px; margin-top:12px }
.opts.g2{ grid-template-columns:1fr 1fr }
.opt{ text-align:left; min-height:56px; border-radius:16px; border:1.5px solid var(--line); background:var(--card); padding:12px 14px;
  display:flex; flex-direction:column; justify-content:center; gap:4px; transition:background .12s, transform .08s }
.opt:not(:disabled):hover{ background:var(--card2); border-color:#3a55a0 }
.opt:not(:disabled):active{ transform:scale(.985) }
.opt .ol{ font-weight:700; font-size:16.5px; display:flex; align-items:center; gap:10px; flex-wrap:wrap }
.opt small{ color:var(--mute); font-size:13.5px; line-height:1.3 }
.opt.ok{ border-color:var(--good); background:rgba(46,230,166,.13) }
.opt.no{ border-color:rgba(255,122,122,.55); background:rgba(255,122,122,.07); opacity:.6; text-decoration:line-through; text-decoration-color:rgba(255,122,122,.8) }
.opt.no small{ text-decoration:none }
.opt.hint{ border-color:var(--amber); box-shadow:0 0 0 3px rgba(255,181,71,.25) }
.aaopt .ol{ font-size:15px }
.aaopt .ol small{ font-weight:400 }
.askrow{ display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:14px }
.askrow .sub{ margin:0 }
.mini{ display:inline-flex; align-items:center; gap:6px; border:1px solid var(--line); background:var(--card); border-radius:999px; padding:7px 12px; font-size:14px; font-weight:700; white-space:nowrap }
.mini .ic{ width:18px; height:18px }
.mini.glow{ border-color:var(--amber); box-shadow:0 0 0 3px rgba(255,181,71,.22) }

/* ---------- tRNA cards ---------- */
.cards{ display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; margin-top:10px }
.card-t{ border:1.5px solid var(--line); background:var(--card); border-radius:18px; padding:10px 4px 9px; min-height:158px;
  display:flex; flex-direction:column; align-items:center; justify-content:flex-start; gap:2px; transition:background .12s, transform .08s }
.card-t:not(:disabled):hover{ background:var(--card2) }
.card-t:not(:disabled):active{ transform:scale(.97) }
.card-t .bead{ margin:0; width:42px; height:42px }
.card-t .trna{ width:56px; height:40px; display:block }
.card-t.no{ opacity:.38; border-color:rgba(255,122,122,.6) }
.card-t.hint{ border-color:var(--amber); box-shadow:0 0 0 3px rgba(255,181,71,.25) }
.anti{ display:flex; align-items:center; gap:2px }
.anti i{ font:700 10px var(--f-m); color:var(--mute); font-style:normal; padding:0 1px }
.card-t .cl{ font:800 14px/1.15 var(--f-d); text-align:center; margin-top:4px }
.card-t small{ font-size:11.5px; color:var(--mute); text-align:center; line-height:1.2 }
.rf svg{ width:58px; height:58px; display:block; margin-top:4px }

/* ---------- chips, word, locks ---------- */
.bank{ display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin-top:14px }
.chip{ background:var(--card); border:1.5px solid var(--line); border-radius:999px; padding:5px; display:grid; place-items:center }
.chip:not(:disabled):hover{ border-color:var(--amber) }
.chip:disabled{ opacity:.25 }
.chip .bead{ margin:0; width:52px; height:52px; font-size:14px }
.word{ display:flex; gap:8px; justify-content:center; margin:6px 0 4px }
.wl{ width:clamp(44px, 13vw, 58px); height:clamp(54px, 15vw, 68px); border-radius:12px; display:grid; place-items:center;
  font:800 clamp(28px, 8vw, 38px)/1 var(--f-d); background:var(--bg2); border:2px dashed var(--dim); color:var(--ink) }
