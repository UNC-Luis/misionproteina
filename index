/* ---------- genetic code sheet ---------- */
function openTable() {
  const sh = $('#sheet');
  $('#sheetTitle').textContent = t(UI.table);
  let g = `<div class="gct"><div class="corner">${t(L('1.ª \\ 2.ª', '1st \\ 2nd'))}</div>${[...B4].map(b => `<div class="hd b-${b}">${b}</div>`).join('')}`;
  for (const a of B4) {
    g += `<div class="hd b-${a}">${a}</div>`;
    for (const b of B4) g += `<div class="cell">${[...B4].map(c => { const x = CODE[a + b + c]; return `<div class="x${x === '*' ? ' stop' : x === 'M' ? ' start' : ''}"><b><span class="c1">${a}${b}</span><span class="c3">${c}</span></b><span>${ab3(x)}</span></div>`; }).join('')}</div>`;
  }
  g += '</div>';
  const list = Object.keys(AA).filter(k => k !== '*').sort((x, y) => ab3(x).localeCompare(ab3(y))).map(k => `<div><b>${ab3(k)}</b>${aaName(k)}</div>`).join('');
  $('#sheetBody').innerHTML = `<p class="howto">${t(L('Busca la <b>1.ª letra</b> del codón en la fila, la <b>2.ª</b> en la columna y la <b>3.ª</b> dentro de la casilla. <b style="color:var(--good)">AUG = inicio</b> · <b style="color:var(--bad)">STOP = parada</b>.', 'Find the codon’s <b>1st letter</b> in the row, the <b>2nd</b> in the column and the <b>3rd</b> inside the box. <b style="color:var(--good)">AUG = start</b> · <b style="color:var(--bad)">STOP = stop</b>.'))}</p>${g}<div class="aalist">${list}</div>`;
  if (sh.hidden) { sh.hidden = false; G.lastFocus = document.activeElement; $('#sheetClose').focus({ preventScroll: true }); }
}
function closeTable() { $('#sheet').hidden = true; if (G.lastFocus && document.contains(G.lastFocus)) G.lastFocus.focus({ preventScroll: true }); }

/* ---------- confetti ---------- */
function confetti() {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const cv = $('#confetti'), cx = cv.getContext('2d'), dpr = Math.min(2, window.devicePixelRatio || 1);
  const W = cv.width = innerWidth * dpr, H = cv.height = innerHeight * dpr; cv.hidden = false;
  const cols = ['#ff6b6b', '#ffd166', '#2ee6a6', '#4dabf7', '#b197fc', '#ffb547'];
  const P = Array.from({ length: 130 }, () => ({ x: W / 2 + (Math.random() - 0.5) * W * 0.4, y: H * 0.3, vx: (Math.random() - 0.5) * W * 0.02, vy: -(Math.random() * 0.022 + 0.006) * H, r: (5 + Math.random() * 6) * dpr, c: cols[Math.random() * cols.length | 0], a: Math.random() * 6, va: (Math.random() - 0.5) * 0.3 }));
  const t0 = performance.now();
  (function f(now) {
    const el = now - t0; cx.clearRect(0, 0, W, H);
    for (const p of P) { p.vy += H * 0.0007; p.vx *= 0.99; p.x += p.vx; p.y += p.vy; p.a += p.va; cx.save(); cx.translate(p.x, p.y); cx.rotate(p.a); cx.globalAlpha = Math.max(0, 1 - el / 2600); cx.fillStyle = p.c; cx.fillRect(-p.r / 2, -p.r / 4, p.r, p.r / 2); cx.restore(); }
    if (el < 2600) requestAnimationFrame(f); else { cx.clearRect(0, 0, W, H); cv.hidden = true; }
  })(t0);
}

/* ---------- events ---------- */
function input(kind, v) {
  const r = G.run; if (G.screen !== 'play' || !r) return;
  const st = r.steps[r.i], view = VIEWS[st.type];
  if (!view[kind]) return;
  view[kind](st, r.s, v, r.ctx);
  renderPlay();
}
let resetArmed = false;
document.addEventListener('click', e => {
  const el = e.target.closest('[data-act],[data-key],[data-opt],[data-tap],[data-m]');
  if (!el || el.disabled) return;
  actx();
  if (el.dataset.key) return input('key', el.dataset.key);
  if (el.dataset.opt != null) return input('opt', +el.dataset.opt);
  if (el.dataset.tap != null) return input('tap', +el.dataset.tap);
  if (el.dataset.m) { closeTable(); return go('brief', el.dataset.m); }
  const a = el.dataset.act;
  if (a !== 'reset') resetArmed = false;
  if (a === 'home') { closeTable(); G.run = null; go('home'); }
  else if (a === 'start') startMission(G.mid);
  else if (a === 'next') next();
  else if (a === 'table') openTable();
  else if (a === 'close') closeTable();
  else if (a === 'cert') go('cert');
  else if (a === 'guide') go('guide');
  else if (a === 'lang') { G.saved.lang = ES() ? 'en' : 'es'; save(); render(); }
  else if (a === 'sound') { G.saved.sound = !G.saved.sound; save(); header(); if (G.saved.sound) sfx('good'); }
  else if (a === 'reset') {
    if (!resetArmed) { resetArmed = true; el.classList.add('arm'); el.textContent = t(L('¿Seguro? Toca otra vez para borrar', 'Sure? Tap again to reset')); return; }
    resetArmed = false; G.saved.done = {}; G.saved.name = ''; save();
    el.classList.remove('arm'); el.textContent = t(L('Progreso borrado ✓', 'Progress cleared ✓'));
  }
});
document.addEventListener('input', e => {
  if (e.target.id !== 'nameIn') return;
  G.saved.name = e.target.value; save();
  const cn = $('#certName'); const v = e.target.value.trim();
  cn.textContent = v || t(L('Tu nombre', 'Your name')); cn.classList.toggle('empty', !v);
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && !$('#sheet').hidden) { closeTable(); return; }
  if (e.target.matches && e.target.matches('input, textarea, select')) return;
  if (e.ctrlKey || e.metaKey || e.altKey) return;
  if (G.screen !== 'play' || !G.run || !$('#sheet').hidden) return;
  const k = e.key.length === 1 ? e.key.toUpperCase() : '';
  const st = G.run.steps[G.run.i];
  if (k && 'ATGCU'.includes(k) && VIEWS[st.type].key) { e.preventDefault(); actx(); input('key', k); }
  else if (e.key === 'Enter' && (G.run.s.done || G.run.s.info) && !(e.target.closest && e.target.closest('button'))) { e.preventDefault(); next(); }
});

/* debug/test hook (harmless for players) */
window.MP = { G, CODE, VIEWS, MISSIONS, startMission, next, input, go };
render();

