/* ---------- small HTML builders ---------- */
const tile = (b, cls = '') => `<span class="t ${b === '?' ? 'qm' : 'b-' + b} ${cls}">${b}</span>`;
const seqTxt = (s, sp = true) => `<span class="seqtxt">${[...s].map((b, i) => (sp && i && i % 3 === 0 ? ' ' : '') + `<span class="b${b}">${b}</span>`).join('')}</span>`;
const bead = (a, cls = '') => `<span class="bead ${aaCls(a)} ${cls}" title="${a === '?' || a === '…' ? '' : aaName(a)}">${a === '?' || a === '…' ? a : ab3(a)}</span>`;
const beadsInline = list => `<span class="binl">${list.map(a => bead(a)).join('')}</span>`;
function chainHTML(list, ghost, newIdx) {
  return `<div class="chain">${list.map((a, i) => bead(a, i === newIdx ? 'new' : '')).join('')}${ghost ? bead(ghost) : ''}</div>`;
}
/* strand row: the end labels are glued to the first/last group so they never wrap alone */
function seqRow(c0, items, c1, cls = '') {
  const it = items.slice(), cap = x => `<span class="cap1">${x}</span>`;
  if (it.length === 1) it[0] = `<span class="cgw">${cap(c0)}${it[0]}${cap(c1)}</span>`;
  else if (it.length) { it[0] = `<span class="cgw">${cap(c0)}${it[0]}</span>`; it[it.length - 1] = `<span class="cgw">${it[it.length - 1]}${cap(c1)}</span>`; }
  return `<div class="seqrow ${cls}">${it.join('')}</div>`;
}
const cgTiles = (c, cls = '', tcls = 'sm') => `<span class="cg${cls}">${[...c].map(b => tile(b, tcls)).join('')}</span>`;
function mrnaTrack(cods, cur, done) {
  return seqRow('5′', cods.map((c, k) => cgTiles(c, `${!done && k === cur ? ' ribo-on' : ''}${k < cur || done ? ' past' : ''}`)), '3′', 'track');
}
const kicker = st => st.tag ? `<div class="kick">${tx(st.tag)}</div>` : '';
const nextBtn = (label, last) => `<button class="btn primary big" type="button" data-act="next">${t(label || (last ? UI.finish : UI.cont))} ${icon('arrow')}</button>`;
function legendHTML(kind) {
  return `<div class="lg"><span><i class="ltpl"></i>${t(UI.tpl)}</span><span><i class="${kind === 'dna' ? 'lnew' : 'lrna'}"></i>${t(kind === 'dna' ? UI.newDNA : UI.newRNA)}</span></div>`;
}
function ladderHTML(top, bot, o = {}) {
  const cap = (a, b) => `<div class="caps" aria-hidden="true"><span>${a}</span><span>${b}</span></div>`;
  const groups = [];
  for (let g = 0; g < top.length; g += 3) {
    let h = '<div class="cg">';
    for (let i = g; i < Math.min(g + 3, top.length); i++) {
      const b = bot[i];
      let lower;
      if (b) lower = o.tap ? `<button class="t b-${b} tapt${i === o.hl ? ' hlx' : ''}" type="button" data-tap="${i}" aria-label="${b} ${i + 1}">${b}</button>` : `<span class="t b-${b}${i === o.pop ? ' pop' : ''}">${b}</span>`;
      else lower = `<span class="t slot${i === o.cur ? ' cur' : ''}"></span>`;
      h += `<div class="bp">${tile(top[i], 'tpl')}<i class="rung${b ? ' on' : ''}"></i>${lower}</div>`;
    }
    groups.push(h + '</div>');
  }
  const last = groups.length - 1;
  groups[0] = `<div class="cgw">${cap('3′', '5′')}${groups[0]}${last === 0 ? cap('5′', '3′') : ''}</div>`;
  if (last > 0) groups[last] = `<div class="cgw">${groups[last]}${cap('5′', '3′')}</div>`;
  return `<div class="ladder">${groups.join('')}</div>`;
}
function keypad(keys, hintKey) {
  return `<div class="keys" style="--n:${keys.length}">${[...keys].map(k => `<button class="key b-${k}${k === hintKey ? ' hint' : ''}" type="button" data-key="${k}" aria-label="${t(BASE_NAME[k])}"><b>${k}</b><small>${t(BASE_NAME[k])}</small></button>`).join('')}</div>`;
}
function locksHTML(ctx, next) {
  return `<div class="locks">${ctx.locks.map((on, i) => `<span class="lk${on ? ' open' : ''}${ctx.opened === i ? ' opening' : ''}${!on && i === next ? ' next' : ''}">${icon(on ? 'unlock' : 'lock')}<b>${i + 1}</b></span>`).join('')}</div>`;
}

/* ===================== step views ===================== */
const MSG = {
  ruleDNA: L('Recuerda: A se empareja con T, y G con C.', 'Remember: A pairs with T, and G with C.'),
  ruleRNA: L('En el ARN: A del molde → U, T → A, G → C, C → G.', 'For RNA: template A → U, T → A, G → C, C → G.'),
  noT: L('¡Cuidado! El ARN no tiene timina (T). En su lugar usa uracilo (U).', 'Careful! RNA has no thymine (T). It uses uracil (U) instead.'),
  noU: L('El ADN no tiene uracilo (U): la U solo aparece en el ARN.', 'DNA has no uracil (U): U only appears in RNA.'),
  ok: L('¡Correcto!', 'Correct!'), retry: L('No es esa. Inténtalo otra vez.', 'Not that one. Try again.')
};
function complete(st, s) {
  s.done = true; s.mood = 'happy'; s.justDone = true;
  const ctx = G.run.ctx;
  if (st.onOk) st.onOk(ctx);
  if (st.unlock != null) { ctx.locks[st.unlock] = true; ctx.opened = st.unlock; sfx('open'); } else sfx('done');
}
const VIEWS = {};

VIEWS.build = {
  init(st) {
    const map = st.kind === 'dna' ? PAIR_DNA : PAIR_RNA;
    return { target: [...st.template].map(b => map[b]).join(''), got: [], wrong: 0, msg: st.hint || (st.kind === 'dna' ? MSG.ruleDNA : MSG.ruleRNA) };
  },
  stage(st, s) {
    return `${kicker(st)}<h2 class="q">${tx(st.prompt)}</h2>${legendHTML(st.kind)}${ladderHTML(st.template, s.got, { cur: s.done ? -1 : s.got.length, pop: s.pop })}${s.done && st.after ? `<div class="note" id="explain">${tx(st.after)}</div>` : ''}`;
  },
  dock(st, s) { return s.done ? nextBtn() : keypad(st.kind === 'dna' ? 'ATGC' : 'AUGCT', s.hintKey); },
  key(st, s, k) {
    if (s.done) return;
    const i = s.got.length, want = s.target[i], tb = st.template[i];
    if (k === want) {
      s.got.push(k); s.pop = i; s.wrong = 0; s.hintKey = null; s.mood = 'ok';
      if (s.got.length === s.target.length) { s.msg = st.doneMsg || L('¡Hebra completa! Bien hecho.', 'Strand complete! Well done.'); complete(st, s); return; }
      s.msg = (i + 1) % 3 === 0 ? PRAISE[((i + 1) / 3) % PRAISE.length] : L(`${tb} ${st.kind === 'dna' ? '↔' : '→'} ${k} ✓`, `${tb} ${st.kind === 'dna' ? '↔' : '→'} ${k} ✓`);
      sfx('good');
    } else {
      s.wrong++; s.mood = 'oops'; s.pop = -1; sfx('bad');
      if (st.kind === 'rna' && k === 'T') s.msg = MSG.noT;
      else if (st.kind === 'dna' && k === 'U') s.msg = MSG.noU;
      else if (s.wrong === 1) s.msg = st.kind === 'dna' ? MSG.ruleDNA : MSG.ruleRNA;
      else { s.msg = L(`La ${tb} del molde se empareja con ${want}.`, `Template ${tb} pairs with ${want}.`); s.hintKey = want; }
    }
  }
};

VIEWS.proof = {
  init(st) {
    const target = [...st.template].map(b => PAIR_DNA[b]).join('');
    return { target, err: [...st.made].findIndex((b, i) => b !== target[i]), got: [...st.made], phase: 'find', wrong: 0,
      msg: L('Revisa cada pareja. Toca la letra de la hebra nueva que está mal.', 'Check every pair. Tap the letter on the new strand that is wrong.') };
  },
  stage(st, s) {
    return `${kicker(st)}<h2 class="q">${tx(st.prompt)}</h2>${legendHTML('dna')}${ladderHTML(st.template, s.got, { tap: s.phase === 'find', cur: s.phase === 'fix' ? s.err : -1, pop: s.pop, hl: s.showErr ? s.err : -1 })}${s.done && st.after ? `<div class="note" id="explain">${tx(st.after)}</div>` : ''}`;
  },
  dock(st, s) { return s.done ? nextBtn() : s.phase === 'fix' ? keypad('ATGC', s.hintKey) : ''; },
  tap(st, s, i) {
    if (s.phase !== 'find') return;
    if (i === s.err) {
      s.phase = 'fix'; s.got[i] = ''; s.wrong = 0; s.mood = 'ok'; sfx('good');
      s.msg = L(`¡Ahí está! ${st.template[i]} no se empareja con ${st.made[i]}. ¿Qué base va ahí?`, `There it is! ${st.template[i]} does not pair with ${st.made[i]}. Which base goes there?`);
    } else {
      s.wrong++; s.mood = 'oops'; sfx('bad');
      s.msg = L(`${st.template[i]}–${s.got[i]} es una pareja correcta. Sigue buscando.`, `${st.template[i]}–${s.got[i]} is a correct pair. Keep looking.`);
      if (s.wrong >= 3) { s.showErr = true; s.msg = L('Pista: mira la letra marcada en amarillo.', 'Hint: look at the letter outlined in yellow.'); }
    }
  },
  key(st, s, k) {
    if (s.phase !== 'fix' || s.done) return;
    const want = s.target[s.err];
    if (k === want) { s.got[s.err] = k; s.pop = s.err; s.msg = L('¡Error corregido! Así trabaja la corrección de pruebas.', 'Mistake fixed! That is how proofreading works.'); complete(st, s); }
    else { s.wrong++; s.mood = 'oops'; sfx('bad'); s.msg = s.wrong >= 2 ? L(`${st.template[s.err]} se empareja con ${want}.`, `${st.template[s.err]} pairs with ${want}.`) : MSG.ruleDNA; if (s.wrong >= 2) s.hintKey = want; }
  }
};

VIEWS.mc = {
  init(st, ctx, seed) {
    const idx = st.options.map((_, i) => i);
    return { order: st.keep ? idx : shuffle(idx, 'o' + seed), picked: [], msg: st.hint || null };
  },
  stage(st, s, ctx) {
    const opts = s.order.map(i => {
      const o = st.options[i], p = s.picked.includes(i);
      return `<button class="opt${o.aa ? ' aaopt' : ''}${p ? (o.ok ? ' ok' : ' no') : ''}${s.hintOpt === i && !p ? ' hint' : ''}" type="button" data-opt="${i}"${s.done || p ? ' disabled' : ''}><span class="ol">${tx(o.html)}</span>${o.sub ? `<small>${tx(o.sub)}</small>` : ''}</button>`;
    }).join('');
    return `${kicker(st)}${st.title ? `<h3 class="ctitle">${tx(st.title)}</h3>` : ''}${st.show ? st.show(ctx, s) : ''}<h2 class="q">${tx(st.prompt)}</h2>${st.tableBtn && !s.done ? `<div class="askrow"><span></span><button class="mini${st.tableGlow ? ' glow' : ''}" type="button" data-act="table">${icon('table')}${t(UI.tableShort)}</button></div>` : ''}<div class="opts${st.cols ? ' g2' : ''}">${opts}</div>${s.done && st.explain ? `<div class="explain" id="explain">${tx(st.explain)}</div>` : ''}`;
  },
  dock(st, s) { return s.done ? nextBtn(null, st.last) : ''; },
  opt(st, s, i) {
    if (s.done || s.picked.includes(i)) return;
    s.picked.push(i);
    const o = st.options[i];
    if (o.ok) { s.msg = o.why || st.okMsg || MSG.ok; complete(st, s); }
    else {
      s.mood = 'oops'; sfx('bad'); s.msg = o.why || MSG.retry;
      const wrongs = s.picked.filter(j => !st.options[j].ok).length;
      if (wrongs >= 2 && st.options.length > 3) s.hintOpt = st.options.findIndex(x => x.ok);
    }
  }
};

VIEWS.tap = {
  init(st) { return { wrong: 0, msg: st.hint || null }; },
  stage(st, s, ctx) {
    return `${kicker(st)}${st.title ? `<h3 class="ctitle">${tx(st.title)}</h3>` : ''}<h2 class="q">${tx(st.prompt)}</h2>${st.show(ctx, s)}${s.done && st.explain ? `<div class="explain" id="explain">${tx(st.explain)}</div>` : ''}`;
  },
  dock(st, s) { return s.done ? nextBtn() : ''; },
  tap(st, s, i) {
    if (s.done) return;
    if (st.accept.includes(i)) { s.badTap = null; s.hintTap = null; s.msg = st.okMsg || L('¡Bien visto!', 'Good eye!'); complete(st, s); }
    else { s.wrong++; s.mood = 'oops'; s.badTap = i; sfx('bad'); s.msg = st.wrong || MSG.retry; if (s.wrong >= 3) s.hintTap = st.accept[0]; }
  }
};

function trnaOptions(c, seed) {
  const a = CODE[c];
  const dis = neighbors(c, 2, true).map(n => ({ anti: anti(n.codon), aa: n.aa }));
  return shuffle([a === '*' ? { rf: true, ok: true } : { anti: anti(c), aa: a, ok: true }, ...dis], 't' + seed);
}
function trnaCard(o) {
  if (o.rf) return `<span class="rf">${RF_SVG}</span><b class="cl">${t(UI.rf)}</b><small>${t(UI.rfSub)}</small>`;
  return `${bead(o.aa)}${TRNA_SVG}<span class="anti"><i>3′</i>${[...o.anti].map(b => tile(b, 'xs')).join('')}<i>5′</i></span><small>${t(L('anticodón', 'anticodon'))}</small>`;
}
VIEWS.trna = {
  init(st, ctx, seed) { const cods = codonsOf(st.mrna); return { cods, i: 0, chain: [], bad: [], opts: cods.map((c, k) => trnaOptions(c, seed + ':' + k)), msg: st.hint }; },
  stage(st, s) {
    const c = s.cods[s.i];
    const ask = L(`El ribosoma lee el codón ${c}. ¿Qué entra?`, `The ribosome reads codon ${c}. What comes in?`);
    return `${kicker(st)}<h2 class="q">${tx(st.prompt)}</h2><div class="lbl">${t(UI.protein)}</div>${chainHTML(s.chain, s.done ? null : '?', s.newBead)}<div class="lbl">${t(UI.mrna)}</div>${mrnaTrack(s.cods, s.i, s.done)}${s.done ? (st.after ? `<div class="note" id="explain">${tx(st.after)}</div>` : '') : `<p class="sub">${t(ask)}</p><div class="cards">${s.opts[s.i].map((o, j) => `<button class="card-t${s.bad.includes(j) ? ' no' : ''}${s.hint === j ? ' hint' : ''}" type="button" data-opt="${j}"${s.bad.includes(j) ? ' disabled' : ''} aria-label="${o.rf ? t(UI.rf) : 'tRNA ' + o.anti + ' ' + ab3(o.aa)}">${trnaCard(o)}</button>`).join('')}</div>`}`;
  },
  dock(st, s) { return s.done ? nextBtn() : ''; },
  opt(st, s, j) {
    if (s.done || s.bad.includes(j)) return;
    const c = s.cods[s.i], o = s.opts[s.i][j];
    if (o.ok) {
      s.bad = []; s.hint = null; s.mood = 'ok';
      if (o.rf) { s.chain.push('*'); s.newBead = s.chain.length - 1; s.msg = L(`${c} es un codón de parada: el factor de liberación suelta la proteína.`, `${c} is a stop codon: the release factor sets the protein free.`); complete(st, s); return; }
      s.chain.push(o.aa); s.newBead = s.chain.length - 1; s.i++; sfx('good');
      s.msg = L(`¡Sí! Anticodón ${o.anti} ↔ codón ${c}. Entra ${AA[o.aa][1]} (${ab3(o.aa)}).`, `Yes! Anticodon ${o.anti} ↔ codon ${c}. In comes ${AA[o.aa][2]} (${ab3(o.aa)}).`);
    } else {
      s.bad.push(j); s.mood = 'oops'; sfx('bad');
      if (CODE[c] === '*') s.msg = L(`Ningún ARNt reconoce ${c}: es un codón de parada.`, `No tRNA recognizes ${c}: it is a stop codon.`);
      else if (o.rf) s.msg = L('El factor de liberación solo entra en un codón de parada (UAA, UAG o UGA).', 'The release factor only enters at a stop codon (UAA, UAG or UGA).');
      else s.msg = L(`El anticodón ${o.anti} no se empareja con ${c}. Revisa letra por letra: A–U y G–C.`, `Anticodon ${o.anti} does not pair with ${c}. Check letter by letter: A–U and G–C.`);
      if (s.bad.length >= 2) s.hint = s.opts[s.i].findIndex(x => x.ok);
    }
  }
};

function aaLabel(a, word) {
  if (a === '*') return `<span class="bead sm stop">STOP</span> <small>${t(L('parada', 'stop'))}</small>`;
  return `${bead(a, 'sm')} <span>${word ? `${ab3(a)} · ${a}` : ab3(a)}</span> <small>${aaName(a)}</small>`;
}
VIEWS.table = {
  init(st, ctx, seed) {
    const cods = codonsOf(st.mrna);
    return { cods, i: 0, chain: [], bad: [], opts: cods.map((c, k) => shuffle([CODE[c], ...neighbors(c, 3, false).map(n => n.aa)], 'a' + seed + k)), msg: st.hint };
  },
  stage(st, s) {
    const c = s.cods[s.i];
    const ask = L(`¿Qué codifica ${c}?`, `What does ${c} code for?`);
    const top = st.word ? `<div class="word">${[...st.word].map((ch, k) => `<span class="wl${s.chain[k] && s.chain[k] !== '*' ? ' on' : ''}">${s.chain[k] && s.chain[k] !== '*' ? s.chain[k] : ''}</span>`).join('')}</div>` : `<div class="lbl">${t(UI.protein)}</div>${chainHTML(s.chain, s.done ? null : '?', s.newBead)}`;
    return `${kicker(st)}<h2 class="q">${tx(st.prompt)}</h2>${top}<div class="lbl">${t(UI.mrna)}</div>${mrnaTrack(s.cods, s.i, s.done)}${s.done ? (st.after ? `<div class="note" id="explain">${tx(st.after)}</div>` : '') : `<div class="askrow"><p class="sub">${t(ask)}</p><button class="mini${s.i === 0 ? ' glow' : ''}" type="button" data-act="table">${icon('table')}${t(UI.tableShort)}</button></div><div class="opts g2">${s.opts[s.i].map((a, j) => `<button class="opt aaopt${s.bad.includes(j) ? ' no' : ''}${s.hint === j ? ' hint' : ''}" type="button" data-opt="${j}"${s.bad.includes(j) ? ' disabled' : ''}><span class="ol">${aaLabel(a, st.word)}</span></button>`).join('')}</div>`}`;
  },
  dock(st, s) { return s.done ? nextBtn() : ''; },
  opt(st, s, j) {
    if (s.done || s.bad.includes(j)) return;
