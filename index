const byId = id => MISSIONS.find(m => m.id === id);

/* ===================== screens ===================== */
const app = $('#app');
function header() {
  const home = G.screen === 'home';
  const back = $('#backBtn');
  back.hidden = home; back.innerHTML = icon('back'); $('.bar').classList.toggle('inner', !home); back.setAttribute('aria-label', t(UI.back));
  $('#brand').innerHTML = `${ribo()}<span>${t(UI.brand)}</span>`;
  $('#tableBtn').innerHTML = icon('table'); $('#tableBtn').setAttribute('aria-label', t(UI.table)); $('#tableBtn').title = t(UI.table);
  $('#langBtn').textContent = ES() ? 'EN' : 'ES'; $('#langBtn').setAttribute('aria-label', t(UI.lang));
  $('#soundBtn').innerHTML = icon(G.saved.sound ? 'sound' : 'mute'); $('#soundBtn').setAttribute('aria-label', t(G.saved.sound ? UI.soundOn : UI.soundOff));
  $('#sheetClose').innerHTML = icon('close'); $('#sheetClose').setAttribute('aria-label', t(UI.close));
